@echo off
REM SolaX plugin: Low Quality
REM Aggiungilo in SolaX > Plugin e fai Save and Launch.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'`n$k='DFIntDebugFRMQualityLevelOverride'`n$v='1'`n$root = Join-Path $env:LOCALAPPDATA 'Roblox\Versions'`n$ver = Get-ChildItem $root -Directory -ErrorAction SilentlyContinue | Where-Object { Test-Path (Join-Path $_.FullName 'RobloxPlayerBeta.exe') } | Sort-Object LastWriteTime -Descending | Select-Object -First 1`nif (-not $ver) { Write-Host 'Roblox non trovato'; exit 1 }`n$dir = Join-Path $ver.FullName 'ClientSettings'`nNew-Item -ItemType Directory -Force -Path $dir | Out-Null`n$f = Join-Path $dir 'ClientAppSettings.json'`n$h = @{}`nif (Test-Path $f) {`n  try {`n    $obj = Get-Content $f -Raw | ConvertFrom-Json`n    $obj.PSObject.Properties | ForEach-Object { $h[$_.Name] = [string]$_.Value }`n  } catch {}`n}`n$h[$k] = [string]$v`n($h | ConvertTo-Json) | Set-Content -Path $f -Encoding UTF8`nWrite-Host ('SolaX plugin OK: ' + $k + '=' + $v)`n"
